# Copy to .env.local for local development, and set the same two
# variables in Vercel (Project → Settings → Environment Variables).
#
# Only the PUBLISHABLE key is used. It is safe in the browser because
# row-level security in Supabase decides what it can do.
# Never add the service-role / secret key to this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
